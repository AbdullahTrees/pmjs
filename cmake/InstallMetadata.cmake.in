file(READ "@CMAKE_CURRENT_BINARY_DIR@/build-config.json" info)
set(build_id "$ENV{PMJS_BUILD_ID}")
if(build_id AND NOT build_id MATCHES "^[A-Za-z0-9][A-Za-z0-9._-]*$")
  message(FATAL_ERROR "PMJS_BUILD_ID must use letters, numbers, dots, underscores or hyphens and start with a letter or number")
endif()
set(build_id_json null)
if(build_id)
  set(build_id_json "\"${build_id}\"")
endif()
set(prefix "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(bundled_node false)
if(EXISTS "${prefix}/bin/node")
  set(bundled_node true)
endif()
string(JSON info SET "${info}" schema 2)
string(JSON info SET "${info}" buildId "${build_id_json}")
string(JSON info SET "${info}" compiledProvenance false)
string(JSON info SET "${info}" source
  "{\"commit\":\"unqualified\",\"dirty\":true,\"sourceDateEpoch\":0}")
string(JSON info SET "${info}" node "{\"bundled\":${bundled_node},\"minimumNodeApi\":8}")
file(WRITE "${prefix}/build-info.json" "${info}\n")
