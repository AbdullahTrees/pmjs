include(FetchContent)
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/tools/lz4.lock.json" lz4_lock)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${CMAKE_CURRENT_SOURCE_DIR}/tools/lz4.lock.json")
string(JSON lz4_archive_sha GET "${lz4_lock}" sha256)
string(JSON lz4_url GET "${lz4_lock}" url)
set(PMJS_LZ4_ARCHIVE "" CACHE FILEPATH "Local archive matching tools/lz4.lock.json")
if(PMJS_OFFLINE AND NOT PMJS_LZ4_ARCHIVE AND NOT FETCHCONTENT_SOURCE_DIR_PMJS_LZ4)
  message(FATAL_ERROR "Offline builds require PMJS_LZ4_ARCHIVE or FETCHCONTENT_SOURCE_DIR_PMJS_LZ4")
endif()
if(PMJS_LZ4_ARCHIVE)
  file(SHA256 "${PMJS_LZ4_ARCHIVE}" archive_sha)
  if(NOT archive_sha STREQUAL lz4_archive_sha)
    message(FATAL_ERROR "LZ4 archive SHA256 does not match tools/lz4.lock.json")
  endif()
  set(lz4_url "${PMJS_LZ4_ARCHIVE}")
endif()
FetchContent_Declare(pmjs_lz4 URL "${lz4_url}" URL_HASH "SHA256=${lz4_archive_sha}"
  SOURCE_SUBDIR unused)
if(PMJS_OFFLINE AND PMJS_LZ4_ARCHIVE)
  set(FETCHCONTENT_FULLY_DISCONNECTED OFF)
endif()
FetchContent_MakeAvailable(pmjs_lz4)
file(STRINGS "${pmjs_lz4_SOURCE_DIR}/lib/lz4.h" lz4_version REGEX "^#define LZ4_VERSION_(MAJOR|MINOR|RELEASE) ")
if(NOT lz4_version MATCHES "MAJOR +1" OR NOT lz4_version MATCHES "MINOR +10" OR NOT lz4_version MATCHES "RELEASE +0")
  message(FATAL_ERROR "Prepared pages require LZ4 1.10.0")
endif()
add_library(pmjs_lz4 STATIC "${pmjs_lz4_SOURCE_DIR}/lib/lz4.c")
target_include_directories(pmjs_lz4 SYSTEM PUBLIC "${pmjs_lz4_SOURCE_DIR}/lib")
