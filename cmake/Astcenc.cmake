include(FetchContent)
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/tools/astcenc.lock.json" astcenc_lock)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${CMAKE_CURRENT_SOURCE_DIR}/tools/astcenc.lock.json")
string(JSON astcenc_sha GET "${astcenc_lock}" sha256)
string(JSON astcenc_url GET "${astcenc_lock}" url)
set(PMJS_ASTCENC_ARCHIVE "" CACHE FILEPATH "Local archive matching tools/astcenc.lock.json")
if(PMJS_OFFLINE AND NOT PMJS_ASTCENC_ARCHIVE AND NOT FETCHCONTENT_SOURCE_DIR_PMJS_ASTCENC)
  message(FATAL_ERROR "Offline builds require PMJS_ASTCENC_ARCHIVE or FETCHCONTENT_SOURCE_DIR_PMJS_ASTCENC")
endif()
if(PMJS_ASTCENC_ARCHIVE)
  set(astcenc_url "${PMJS_ASTCENC_ARCHIVE}")
endif()
foreach(isa AVX2 SSE41 SSE2 NEON NONE NATIVE)
  set(ASTCENC_ISA_${isa} OFF CACHE BOOL "" FORCE)
endforeach()
if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
  set(astcenc_isa neon)
  set(ASTCENC_ISA_NEON ON CACHE BOOL "" FORCE)
elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
  set(astcenc_isa sse2)
  set(ASTCENC_ISA_SSE2 ON CACHE BOOL "" FORCE)
else()
  set(astcenc_isa none)
  set(ASTCENC_ISA_NONE ON CACHE BOOL "" FORCE)
endif()
set(ASTCENC_CLI OFF CACHE BOOL "" FORCE)
set(ASTCENC_UNITTEST OFF CACHE BOOL "" FORCE)
set(ASTCENC_SHAREDLIB OFF CACHE BOOL "" FORCE)
set(ASTCENC_DECOMPRESSOR OFF CACHE BOOL "" FORCE)
FetchContent_Declare(pmjs_astcenc URL "${astcenc_url}" URL_HASH "SHA256=${astcenc_sha}")
if(PMJS_OFFLINE AND PMJS_ASTCENC_ARCHIVE)
  set(FETCHCONTENT_FULLY_DISCONNECTED OFF)
endif()
FetchContent_MakeAvailable(pmjs_astcenc)
add_library(pmjs_astcenc ALIAS astcenc-${astcenc_isa}-static)
